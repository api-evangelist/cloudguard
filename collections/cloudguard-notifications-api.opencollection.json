{
  "opencollection": "1.0.0",
  "info": {
    "name": "Check Point CloudGuard CNAPP REST CloudAccounts Notifications API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Notifications",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create a notification policy",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.dome9.com/v2/notification"
          },
          "docs": "Create a notification policy"
        },
        {
          "info": {
            "name": "Update a notification policy",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.dome9.com/v2/notification"
          },
          "docs": "Update a notification policy"
        },
        {
          "info": {
            "name": "Get notification policy",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.dome9.com/v2/notification/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get notification policy"
        }
      ]
    }
  ],
  "bundled": true
}